{
  "env": {
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
    // "CLAUDE_CODE_DISABLE_CLAUDE_MDS": "1",
    // "CLAUDE_CODE_DISABLE_CRON": "1",
    // "ENABLE_TODO_TOOLS": "0",
    // "CLAUDE_CODE_SIMPLE_SYSTEM_PROMPT": "1"
  },

  "disableClaudeAiConnectors": true,
  "disableWorkflows": true,
  "disableBundledSkills": true,
  "disableArtifact": true,
  "includeGitInstructions": false,
  "autoMemoryEnabled": false,

  // "disableAllHooks": true,
  // "enableAllProjectMcpServers": false,
  // "disabledMcpjsonServers": [],
  // "disabledBuiltinTools": [],
  // "skillOverrides": {},
  // "alwaysThinkingEnabled": false,
  // "autoCompactEnabled": true,

  "permissions": {
    "deny": [
      // "Bash",
      // "Read",
      // "Edit",
      // "Write",
      "Glob",
      "Grep",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Task",
      "TodoWrite",
      "TaskCreate",
      "TaskUpdate",
      "TaskGet",
      "TaskList",
      "TaskStop",
      "Skill",
      "REPL",
      "AskUserQuestion",
      "SendUserMessage",
      "Agent",
      "ListAgents",
      "ShareOnboardingGuide",
      "Artifact",
      "Workflow",
      "ReportFindings",
      "ScheduleWakeup",
      "DesignSync",
      "CronCreate",
      "CronDelete",
      "CronList",
      "PushNotification",
      "RemoteTrigger",
      "EnterPlanMode",
      "ExitPlanMode",
      "EnterWorktree",
      "ExitWorktree",
      "Monitor",
      "TaskOutput",
      "SendMessage",
      "EndConversation",
      "BashOutput",
      "KillShell",
    ],
  },

  "statusLine": {
    "type": "command",
    "command": "node /Users/benjamin/.claude/statusline.js",
  },
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true,
  },
  "effortLevel": "medium",
  "model": "opus[1m]",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
}
